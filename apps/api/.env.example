# API runtime config — copy to .env and adjust.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hub:hub@localhost:5433/a2sv_hub
# 32+ char secret for signing access tokens
JWT_SECRET=dev-only-change-me-32-chars-minimum
# Access token TTL (short-lived) + refresh TTL
JWT_EXPIRES=15m
REFRESH_EXPIRES=30d
# Invitation link TTL
INVITE_EXPIRES=7d
# Verified origins for CORS (space separated)
WEB_ORIGIN=http://localhost:3100

# Email delivery. `preview` logs the rendered email; `smtp` sends for real.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=abdulhamidhayredin94@gmail.com
SMTP_PASS=hpbiugkezivqjfhl
MAIL_FROM=Akiba Tech <abdulhamidhayredin94@gmail.com>