{
  "name": "@hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "lint": "echo 'api: lint placeholder'",
    "db:migrate": "pnpm --filter @hub/database db:migrate",
    "db:seed": "pnpm --filter @hub/database db:seed"
  },
  "dependencies": {
    "@hub/database": "workspace:*",
    "@hub/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}