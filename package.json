{
  "name": "a2sv-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @hub/web dev",
    "dev:api": "pnpm --filter @hub/api dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @hub/database db:generate",
    "db:migrate": "pnpm --filter @hub/database db:migrate",
    "db:push": "pnpm --filter @hub/database db:push",
    "db:seed": "pnpm --filter @hub/database db:seed",
    "db:studio": "pnpm --filter @hub/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.2"
  }
}
